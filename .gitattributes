# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Rust files
*.rs text diff=rust
Cargo.toml text
Cargo.lock text -diff

# Documentation
*.md text diff=markdown
*.txt text
LICENSE text

# Config files
*.json text
*.toml text
*.yml text
*.yaml text
*.ini text
*.cfg text
*.conf text

# SQL files
*.sql text

# Shell scripts
*.sh text eol=lf diff=bash

# Docker files
Dockerfile text
*.dockerfile text
docker-compose*.yml text
.dockerignore text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Font files
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary

# Archive files
*.zip binary
*.7z binary
*.gz binary
*.tar binary
*.tgz binary
*.rar binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Snapshot test files (todo #135). Force text + LF so insta snapshots
# stay byte-identical across macOS, Linux, and Windows -- the previous
# `binary` attribute hid line-ending churn but still allowed CRLF
# checkouts on Windows. Diffing is intentionally suppressed because
# regenerated snapshots are reviewed via `insta`'s own tooling, not git.
*.snap text eol=lf -diff
*.snap.new text eol=lf -diff

# Environment files
.env text eol=lf

# Export ignore (excluded from archives)
.github/ export-ignore
.claude/ export-ignore
